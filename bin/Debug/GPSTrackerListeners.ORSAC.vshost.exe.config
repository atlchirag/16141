<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="superSocket" type="SuperSocket.SocketEngine.Configuration.SocketServiceConfig, SuperSocket.SocketEngine"/>
  </configSections>
  <appSettings>
    <add key="ServiceName" value="ListenerORSAC"/>
  </appSettings>


  <superSocket>
    <servers>
      <server name="ORSAC_2525" serverTypeName="ORSAC" ip="Any" port="2525" maxConnectionNumber="10000" maxRequestLength="9096" dbType="SQLServer" logFolder="E:\ListenerData\ORSAC\2525">

      </server>
   

      <server name="ManagementServer" serverType="SuperSocket.ServerManager.ManagementServer, SuperSocket.ServerManager" excludedServers="SilverlightPolicyServer">
        <listeners>
          <add ip="Any" port="6500"/>
        </listeners>

        <users>
          <user name="kerry" password="123456"/>
        </users>
      </server>
    
    
    </servers>
 
    <serverTypes>
      <add name="ORSAC" type="GPSTrackerListeners.ORSAC.ORSACServer, GPSTrackerListeners.ORSAC"/>
      
     
     
    </serverTypes>
   
  </superSocket>


  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2"/>
  </startup>
</configuration>
